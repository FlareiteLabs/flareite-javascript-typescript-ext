; Folding regions for TypeScript. Each capture's first line stays visible
; when it is folded; a last line that closes it (like `}`) stays visible too.
[
  (statement_block)
  (class_body)
  (switch_body)
  (interface_body)
  (enum_body)
  (object_type)
  (object)
  (array)
  (object_pattern)
  (array_pattern)
  (arguments)
  (formal_parameters)
  (type_parameters)
  (named_imports)
  (template_string)
  (comment)
] @fold
